{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entruempelung-thueringen",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "entruempelung-thueringen.com/*", "zone_name": "entruempelung-thueringen.com" },
    { "pattern": "www.entruempelung-thueringen.com/*", "zone_name": "entruempelung-thueringen.com" }
  ]
}
